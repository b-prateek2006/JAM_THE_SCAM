# Copy to backend/.env. Everything is optional: with nothing set, the app runs on
# L1 rules + L2 embeddings, server Whisper STT, and a WhatsApp link for family alerts.

# --- L3 LLM reasoner. Every provider with a key is used: LLM_PROVIDER (groq|gemini|anthropic) first,
# and a failed call (e.g. a free key's rate limit) is retried once on the next. LLM_PROVIDER=none turns L3 off.
# Groq and Gemini both have free keys (no card): set both so one can cover for the other.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=            # overrides the first provider's model. Defaults: groq qwen/qwen3.8-27b (or openai/gpt-oss-120b), gemini gemini-3.5-flash, anthropic claude-opus-5-5
# LLM_INTERVAL_S=20     # routine L3 check this often...
# LLM_MIN_GAP_S=15      # ...or sooner when L1/L2 flag something, but never within this many seconds of the last
# LLM_TIMEOUT_S=10      # per call; a rate-limited (429) provider is skipped for its retry-after

# --- L2 embeddings
# EMBED_BACKEND=auto    # auto | st | ngram (ngram needs no ML packages)
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- Speech-to-text
# STT_BACKEND=whisper   # whisper | sarvam | none
# WHISPER_MODEL=small   # tiny | base | small | medium
# SARVAM_API_KEY=       # Indic STT for Telugu (STT_BACKEND=sarvam)

# --- Family SMS at level 3 (otherwise the app shows a WhatsApp click-to-chat link)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# SMS only goes to these numbers (comma-separated, or * for any). Empty = never SMS, WhatsApp link only.
# SMS_ALLOWLIST=9876543210

# --- Public-deploy limits
# STORE_INCIDENTS=0     # 1 = also save kept reports in server SQLite (DB_PATH); the PWA keeps its own on-device history
# MAX_SESSIONS=6        # concurrent live calls (WebSockets); more get "server busy"
# MAX_SESSION_S=1200    # a guarded call is ended (with its report) after this long
# MAX_TEXT_CHARS=1000   # longest text line accepted per message
# ANALYZE_PER_MIN=10    # /api/analyze requests per client IP per minute
# CORS_ORIGINS=         # extra origins allowed to call the API cross-site; the PWA itself is same-origin
